:8080 {
    request_body {
        max_size 2MB
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        header {
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy no-referrer
            Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
        try_files {path} /index.html
        file_server
    }
}
