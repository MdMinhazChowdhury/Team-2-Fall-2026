# Development Compose settings. Generate independent keys before starting.
# Use a URL-safe password; Compose embeds it in a database URL.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
TASKTRACK_ENV=development
TASKTRACK_DATABASE_URL=postgresql+psycopg://tasktrack:change-me@postgres:5432/tasktrack
TASKTRACK_REDIS_URL=redis://redis:6379/0
TASKTRACK_SESSION_SECRET=replace-with-a-long-random-value
TASKTRACK_PUBLIC_ORIGIN=http://localhost:8080
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TASKTRACK_EMAIL_KEY=
TASKTRACK_EMAIL_ENABLED=true
TASKTRACK_SMTP_HOST=localhost
TASKTRACK_SMTP_PORT=1025
TASKTRACK_EMAIL_FROM=tasktrack@localhost
TASKTRACK_RATE_LIMIT=20
